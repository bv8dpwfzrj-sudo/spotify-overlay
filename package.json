{
  "name": "spotify-overlay",
  "version": "1.1.1",
  "description": "Transparent always-on-top Spotify now-playing widget",
  "author": "Spotify Overlay",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "local.spotifyoverlay",
    "productName": "Spotify Overlay",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "smtc.ps1",
      "package.json",
      "build/icon.png",
      "tap/bin/SpotifyTap.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
